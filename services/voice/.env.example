# Required for live Gradium STT/TTS (get from https://gradium.ai)
GRADIUM_API_KEY=

# Gradium voice library ID used for AURA agent speech
GRADIUM_VOICE_ID=_6Aslh2DxfmnRLmP

# live | playback | text
VOICE_MODE=live

# Shresth gateway base URL (no trailing slash)
GATEWAY_URL=http://localhost:8000

# Voice service HTTP bind
VOICE_HOST=0.0.0.0
VOICE_PORT=8100

# Language code for sessions when MULTILINGUAL=false (en|es|fr|de|pt)
DEFAULT_LANGUAGE=en

# true = Gradium STT language=any + reply/TTS follow detected caller language
MULTILINGUAL=true

# --- Noise / barge-in ---
# off = mute mic while agent speaks (recommended in noisy rooms)
# transcript = only interrupt when Gradium produces real text
# vad = interrupt on any speech-start (sensitive to ambient)
BARGE_IN_MODE=off
BARGE_IN_MIN_CHARS=12

VAD_MIN_VOLUME=0.55
VAD_CONFIDENCE=0.75
VAD_START_SECS=0.35
VAD_STOP_SECS=0.5

GRADIUM_TURN_DETECTION=false
GRADIUM_EOT_HORIZON_S=3.0
GRADIUM_EOT_THRESHOLD=0.4
GRADIUM_DELAY_IN_FRAMES=16

# Throttle audio.level events to frontend (Hz)
AUDIO_LEVEL_HZ=15

# Fixed safe line when Gradium/gateway fails
SAFE_FALLBACK_LINE=Please stay on the line while I connect you to a dispatcher.
