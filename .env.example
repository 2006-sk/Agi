# General Compute (hosted SambaNova inference) - OpenAI-compatible endpoint
GENERALCOMPUTE_API_KEY=gc-your-key-here
GC_BASE_URL=https://api.generalcompute.com/v1
# Default model on General Compute. Run `npm run check-model` to list what is live
# and swap to e.g. Meta-Llama-3.3-70B-Instruct if served.
GC_MODEL=gpt-oss-120b

# Model call guardrails
MODEL_TIMEOUT_MS=4000
MODEL_MAX_TOKENS=600
CONFIDENCE_THRESHOLD=0.5

# Set to true to run entirely offline with canned model responses (tests / fallback demo)
USE_MOCK_MODEL=false

# HTTP server
PORT=8082
HOST=0.0.0.0
LOG_LEVEL=info
